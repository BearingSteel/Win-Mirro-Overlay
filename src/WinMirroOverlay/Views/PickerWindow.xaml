<Window x:Class="WinMirroOverlay.Views.PickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:common="clr-namespace:WinMirroOverlay.Common"
        Title="Win-Mirro-Overlay"
        Width="560" Height="600" MinWidth="440" MinHeight="320"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="13"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10"
                ClipToBounds="True">
            <ListBox x:Name="WindowList"
                     Background="Transparent" BorderThickness="0"
                     Foreground="{StaticResource TextBrush}"
                     Padding="0,6,0,6"
                     SelectionMode="Single"
                     ItemContainerStyle="{StaticResource PickItemStyle}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.ScrollUnit="Pixel"
                     MouseLeftButtonUp="WindowList_MouseLeftButtonUp">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type common:WindowInfo}">
                        <Grid Margin="10,7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="30" Height="30" CornerRadius="6" Background="#1AFFFFFF" Margin="0,0,12,0">
                                <Image Source="{Binding Icon}" Width="20" Height="20"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" FontSize="13.5"
                                           Foreground="{StaticResource TextBrush}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Subtitle}" FontSize="11"
                                           Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <Grid Grid.Row="1" Margin="0,12,0,0">
            <TextBlock x:Name="CountText" VerticalAlignment="Center"
                       Foreground="{StaticResource MutedBrush}" />
            <Button x:Name="RefreshButton" HorizontalAlignment="Right"
                    Style="{StaticResource SecondaryButton}"
                    Click="Refresh_Click" />
        </Grid>
    </Grid>
</Window>

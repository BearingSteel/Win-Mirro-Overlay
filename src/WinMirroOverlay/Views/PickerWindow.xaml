<Window x:Class="WinMirroOverlay.Views.PickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:common="clr-namespace:WinMirroOverlay.Common"
        Title="选择需要镜像显示的窗口"
        Width="580" Height="660" MinWidth="440" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="13"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <Grid Margin="22,20,22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="选择需要镜像显示的窗口" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="单击列表中的窗口即可开始镜像；关闭本窗口将退出程序。"
                       Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Margin="0,18,0,12" Padding="10,0"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Left" Text="&#xE721;"
                           FontFamily="Segoe MDL2 Assets" FontSize="13"
                           Foreground="{StaticResource MutedBrush}"
                           VerticalAlignment="Center" Margin="2,0,10,0" />
                <Grid>
                    <TextBox x:Name="SearchBox" Height="38"
                             Background="Transparent" BorderThickness="0"
                             Foreground="{StaticResource TextBrush}"
                             CaretBrush="{StaticResource TextBrush}"
                             VerticalContentAlignment="Center"
                             TextChanged="SearchBox_TextChanged" />
                    <TextBlock x:Name="SearchPlaceholder" Text="搜索窗口标题或进程名…"
                               Foreground="{StaticResource MutedBrush}"
                               VerticalAlignment="Center" Margin="2,0,0,0"
                               IsHitTestVisible="False" />
                </Grid>
            </DockPanel>
        </Border>

        <Border Grid.Row="2" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10"
                ClipToBounds="True">
            <ListBox x:Name="WindowList"
                     Background="Transparent" BorderThickness="0"
                     Padding="0,6,0,6"
                     SelectionMode="Single"
                     ItemContainerStyle="{StaticResource PickItemStyle}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.ScrollUnit="Pixel"
                     MouseLeftButtonUp="WindowList_MouseLeftButtonUp">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type common:WindowInfo}">
                        <Grid Margin="10,7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="30" Height="30" CornerRadius="6" Background="#1AFFFFFF" Margin="0,0,12,0">
                                <Image Source="{Binding Icon}" Width="20" Height="20"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" FontSize="13.5"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Subtitle}" FontSize="11"
                                           Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <TextBlock x:Name="CountText" VerticalAlignment="Center"
                       Foreground="{StaticResource MutedBrush}" />
            <Button Content="刷新列表" HorizontalAlignment="Right"
                    Style="{StaticResource SecondaryButton}"
                    Click="Refresh_Click" />
        </Grid>
    </Grid>
</Window>
